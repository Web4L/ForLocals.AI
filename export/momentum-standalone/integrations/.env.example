# ──────────────────────────────────────────────────────────────────────────
# Momentum COO OS — integration credentials (TEMPLATE)
#
# Copy to `.env` (git-ignored) and fill with real values. NEVER commit `.env`.
# See docs/strategy/momentum-coo-os.md §2.4 (Security) and §3 (Credentials).
# Rotate community-MCP tokens on a schedule — they grant full account access.
# ──────────────────────────────────────────────────────────────────────────

# --- GoHighLevel (engagement engine) -----------------------------------------
# Private Integrations token (NOT the legacy API key) + Location ID.
# Source: Momentum sub-account → Settings → Private Integrations / Business Profile.
GHL_API_KEY=
GHL_LOCATION_ID=

# --- MindBody (system of record) ---------------------------------------------
# From developers.mindbodyonline.com. Test against the SANDBOX before live.
# `_SOURCE_*` are the API partner/source credentials; `_SITE_ID` is Momentum's site.
MINDBODY_API_KEY=
MINDBODY_SITE_ID=
MINDBODY_SOURCE_NAME=
MINDBODY_SOURCE_PASSWORD=

# --- Environment toggle ------------------------------------------------------
# sandbox | staging | live  — keep at sandbox until write paths are verified (§5).
COO_OS_ENV=sandbox
